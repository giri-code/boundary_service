# ── Service Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# ── Shared Internal Service Secret (must match interactive_gallery) ─────────────
INTERNAL_SERVICE_SECRET=super-secret-boundary-token-123

# ── Storage Backend ("s3", "local", "auto") ─────────────────────────────────────
STORAGE_BACKEND=s3
S3_BUCKET=rapidbuy-bucket
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=auto
S3_PUBLIC_DOMAIN=http://rapid-buy.kiddocolor.com

# ── Redis Cache & Queue ────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
