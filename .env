# ── Service Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=local
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# ── Storage Backend ("auto", "local", "s3", "gcs") ────────────────────────────
STORAGE_BACKEND=auto
LOCAL_STORAGE_ROOT=./storage
MAX_IMAGE_FILE_SIZE_MB=50
MAX_IMAGE_PIXELS=36000000
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.heic,.heif,.avif
MIN_HOLE_AREA_PIXELS=10

# ── AWS S3 Configuration (fill in when deploying to AWS) ──────────────────────
# AWS_S3_BUCKET=my-marketing-photos-bucket
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1

# ── GCP Cloud Storage Configuration (fill in when deploying to GCP) ───────────
# GCP_GCS_BUCKET=my-marketing-gcs-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-credentials.json

# ── Segmentation Model Provider ────────────────────────────────────────────────
# "mobile_sam" is the default AI model. Weights will auto-download on first use.
SEGMENTATION_MODEL_PROVIDER=mobile_sam
MODEL_WEIGHTS_DIR=./models
DEFAULT_POLYGON_TOLERANCE=0.005
EMBEDDING_CACHE_SIZE=15
ENABLE_ROI_CROPPING=True
MAX_ROI_DIMENSION=1024
HEALTH_CACHE_TTL_SECONDS=5
