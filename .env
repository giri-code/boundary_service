# ── Service Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=local
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# ── Shared Internal Service Secret (matches interactive_gallery) ───────────────
INTERNAL_SERVICE_SECRET=super-secret-boundary-token-123

# ── Local MinIO S3 Storage (matches interactive_gallery) ────────────────────────
STORAGE_BACKEND=s3
S3_BUCKET=photos
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_DOMAIN=http://localhost:9000/photos

# ── Local Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
