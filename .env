# ── Service Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=local
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# ── Shared Internal Service Secret (matches interactive_gallery) ───────────────
INTERNAL_SERVICE_SECRET=super-secret-boundary-token-123

# ── Local File System Storage (zero Cloudflare R2 / S3 in local) ───────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage

# ── Local Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
